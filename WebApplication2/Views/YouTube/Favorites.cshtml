@model List<WebApplication2.Models.Video>

@{
    ViewData["Title"] = "Ulubione wideo";
    var profiles = ViewData["Profiles"] as List<WebApplication2.Models.Profile> ?? new List<WebApplication2.Models.Profile>();
    var selectedProfileId = ViewData["SelectedProfileId"] as int?;
    var searchQuery = ViewData["SearchQuery"] as string ?? "";
}

<h2>⭐ Ulubione wideo</h2>

<!-- Formularz filtrowania -->
<form method="get" asp-controller="YouTube" asp-action="Favorites" class="mb-4">
    <div class="form-row d-flex align-items-end gap-3">
        <div class="form-group">
            <label for="searchQuery">Szukaj po nazwie:</label>
            <input type="text" name="searchQuery" id="searchQuery" value="@searchQuery" class="form-control" />
        </div>

        <div class="form-group">
            <label for="profileId">Filtruj po profilu:</label>
            <select name="profileId" id="profileId" class="form-control">
                <option value="">Wszystkie profile</option>
                @foreach (var profile in profiles)
                {
                    <option value="@profile.Id" selected="@(selectedProfileId == profile.Id ? "selected" : null)">
                        @profile.Name
                    </option>
                }
            </select>
        </div>

        <div class="form-group">
            <button type="submit" class="btn btn-primary">🔍 Filtruj</button>
        </div>
    </div>
</form>

<!-- Jeśli brak wyników -->
@if (Model.Count == 0)
{
    <p class="text-center">❌ Brak zapisanych filmów spełniających kryteria.</p>
}
else
{
    <!-- Lista filmów -->
    <div class="container">
        <div class="row">
            @foreach (var video in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card">
                        <iframe class="card-img-top" width="100%" height="200"
                                src="https://www.youtube.com/embed/@video.VideoId"
                                frameborder="0" allowfullscreen>
                        </iframe>

                        <div class="card-body text-center">
                            <h6 class="card-title">@video.Title</h6>

                            <form asp-controller="YouTube" asp-action="RemoveFromFavorites" method="post">
                                <input type="hidden" name="videoId" value="@video.VideoId" />
                                <button type="submit" class="btn btn-danger mt-2">❌ Usuń</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}
