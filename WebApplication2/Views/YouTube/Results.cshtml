@model List<WebApplication2.Models.Video>

@{
    ViewData["Title"] = "Wyniki wyszukiwania";
}

<!-- Nagłówek strony -->
<h2>📺 Znalezione filmy</h2>

<div class="container">
    <div class="row">
        @foreach (var video in Model)
        {
            var isFavorite = ViewData["Favorites"] as List<string> ?? new List<string>();
            var profiles = ViewData["Profiles"] as List<WebApplication2.Models.Profile>;

            <div class="col-md-4 mb-4">
                <div class="card">
                    <!-- Podgląd filmu z YouTube -->
                    <iframe class="card-img-top" width="100%" height="200" 
                            src="https://www.youtube.com/embed/@video.VideoId" 
                            frameborder="0" allowfullscreen>
                    </iframe>

                    <div class="card-body text-center">
                        <h6 class="card-title">@video.Title</h6>

                        @if (!isFavorite.Contains(video.VideoId))
                        {
                            if (profiles == null || !profiles.Any())
                            {
                                <p class="text-danger">⚠️ Brak dostępnych profili. Utwórz profil, zanim dodasz film do ulubionych.</p>
                            }
                            else
                            {
                                <!-- Formularz dodania do ulubionych -->
                                <form id="add-to-favorites-form-@video.VideoId" asp-controller="YouTube" asp-action="AddToFavorites" method="post" class="add-to-favorites-form">
                                    <input type="hidden" name="videoId" value="@video.VideoId" />
                                    <input type="hidden" name="title" value="@video.Title" />
                                    <input type="hidden" name="channelId" value="@video.ChannelId" />
                                    <input type="hidden" name="publishedAt" value="@video.PublishedAt" />

                                    <label for="profileId">Wybierz profil:</label>
                                    <select name="profileId" class="form-control">
                                        @foreach (var profile in profiles)
                                        {
                                            <option value="@profile.Id">@profile.Name</option>
                                        }
                                    </select>

                                    <button type="submit" class="btn btn-warning mt-2">⭐ Dodaj do ulubionych</button>
                                </form>
                            }
                        }
                        else
                        {
                            <!-- Jeśli już w ulubionych -->
                            <button class="btn btn-success mt-2" disabled>✅ W ulubionych</button>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        // AJAX request to add video to favorites
        $(".add-to-favorites-form").submit(function (e) {
            e.preventDefault(); // prevent form submission

            var form = $(this);
            $.ajax({
                type: "POST",
                url: form.attr("action"),
                data: form.serialize(),
                success: function (response) {
                    var button = form.find("button");
                    button.replaceWith('<button class="btn btn-success mt-2" disabled>✅ W ulubionych</button>');
                },
                error: function () {
                    alert("Error adding to favorites.");
                }
            });
        });
    </script>
}
